{
  "name": "game-of-torments",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Game of Torments — jogo de cartas solo com bot de treino",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "build:single": "tsc --noEmit && vite build --mode single",
    "preview": "vite preview",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "sim": "tsx scripts/sim.ts"
  },
  "dependencies": {
    "@fontsource/lora": "5.1.0",
    "@fontsource/playfair-display": "5.1.0"
  },
  "devDependencies": {
    "@types/node": "^20.17.6",
    "tsx": "4.19.2",
    "typescript": "5.6.3",
    "vite": "5.4.11",
    "vite-plugin-singlefile": "2.0.3",
    "vitest": "2.1.8"
  }
}
